---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ForumSubnav from '../../../components/ForumSubnav.astro';
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { forumFacts, siteConfig } from '../../../data/site';
import { withBase } from '../../../lib/urls';
---

<BaseLayout title="Travel & Accessibility — Forum 2026" description="Current travel, venue, and accessibility status for the SPARK Forum 2026.">
  <PageHero eyebrow="Forum 2026 · Travel & access" title="Plan only from confirmed information." description={`The Forum will take place in ${forumFacts.locationLabel}, with a current planning window of ${forumFacts.dateLabel.toLowerCase()}. Exact dates and the specific venue are still being finalized. This page will become the authoritative public source for travel, lodging, local transportation, access, and participation support.`} status="planning" compact />
  <ForumSubnav />
  <section class="section section-white"><div class="container"><div class="notice"><Icon name="location" size={21}/><p><strong>Confirmed location: {forumFacts.locationLabel}. Planning window: {forumFacts.dateLabel}.</strong> The exact venue, dates, lodging, and transportation arrangements are not yet published. Please wait for those details before booking travel.</p></div><div class="mt-3"><SectionHeading eyebrow="What will appear here" title="One practical guide for the full participant journey." description="Once the remaining arrangements are confirmed, this page will consolidate the information participants need instead of scattering it across emails and PDFs."/></div><div class="card-grid"><article class="icon-card"><span class="icon-card-icon"><Icon name="location" size={22}/></span><h3>Venue and arrival</h3><p>Confirmed address, nearest airports or stations, local transit, shuttle arrangements, arrival windows, and on-site navigation.</p></article><article class="icon-card"><span class="icon-card-icon"><Icon name="calendar" size={22}/></span><h3>Lodging and support</h3><p>Covered dates, booking process, reimbursement guidance, meals, accompanying-family policy, and participant costs.</p></article><article class="icon-card"><span class="icon-card-icon"><Icon name="people" size={22}/></span><h3>Access and inclusion</h3><p>Step-free access, mobility, sensory conditions, dietary planning, rest spaces, captions, materials, and confidential request channels.</p></article></div></div></section>
  <section class="section"><div class="container access-grid"><div><p class="eyebrow"><span aria-hidden="true"></span>Accessibility approach</p><h2>Access needs belong in event design.</h2></div><div class="prose"><p>The organizing team intends to gather access requirements through an approved private form and to communicate what the venue and program can support before participants commit to travel.</p><p>Public pages and core program information will be available in accessible HTML. Videos selected for release should include captions, and important recordings should include transcripts where feasible. PDF files will not be the only source for essential information.</p><p>If you have a planning question that does not require sharing sensitive personal information, contact <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.</p></div></div></section>
  <section class="section section-white"><div class="container next-links"><a href={withBase('forum/2026/faq/')}><span>Questions about the forum?</span><strong>Read the planning FAQ <Icon name="arrow-right" size={17}/></strong></a><a href={withBase('accessibility/')}><span>About this website</span><strong>View our accessibility statement <Icon name="arrow-right" size={17}/></strong></a></div></section>
</BaseLayout>

<style>.access-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(3rem,8vw,7rem)}.access-grid h2{margin-top:.7rem}.next-links{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.next-links a{display:flex;flex-direction:column;padding:1.5rem;text-decoration:none}.next-links a+a{border-left:1px solid var(--line)}.next-links span{color:var(--muted);font-size:.73rem}.next-links strong{display:flex;align-items:center;gap:.4rem;margin-top:.4rem;color:var(--navy-950)}@media(max-width:760px){.access-grid,.next-links{grid-template-columns:1fr}.next-links a+a{border-left:0;border-top:1px solid var(--line)}}</style>
