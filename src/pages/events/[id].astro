---
import { getCollection,render,type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { formatDateTime } from '../../lib/dates';
import { withBase } from '../../lib/urls';

export async function getStaticPaths(){const entries=await getCollection('events',({data})=>!data.draft);return entries.map(entry=>({params:{id:entry.id},props:{entry}}));}
interface Props{entry:CollectionEntry<'events'>}
const {entry}=Astro.props;const {data}=entry;const {Content}=await render(entry);
---

<BaseLayout title={data.title} description={data.summary}>
  <PageHero eyebrow="Community event" title={data.title} description={data.summary} status={data.status} compact><div slot="actions" class="page-actions">{data.registrationUrl?<a class="button button-gold" href={data.registrationUrl} target="_blank" rel="noopener noreferrer">Register externally <Icon name="external" size={17}/></a>:entry.id==='spark-forum-2026'?<a class="button button-gold" href={withBase('forum/2026/')}>Explore Forum planning <Icon name="arrow-right" size={17}/></a>:null}</div></PageHero>
  <section class="section section-white"><div class="container"><Breadcrumbs items={[{label:'Events',href:'events/'},{label:data.title}]}/><div class="detail-layout"><article class="prose"><Content/></article><aside class="detail-sidebar"><h2>Event details</h2><dl class="detail-facts"><div class="detail-fact"><dt>Status</dt><dd><StatusBadge status={data.status}/></dd></div><div class="detail-fact"><dt>Date and time</dt><dd>{data.startAt?<time datetime={data.startAt.toISOString()}>{formatDateTime(data.startAt,data.timezone)}</time>:data.dateLabel??'To be confirmed'}</dd></div><div class="detail-fact"><dt>Format</dt><dd>{data.format.replaceAll('-',' ')}</dd></div><div class="detail-fact"><dt>Location</dt><dd>{data.location??'To be confirmed'}</dd></div></dl>{data.registrationUrl&&<a class="button button-primary button-full" href={data.registrationUrl} target="_blank" rel="noopener noreferrer">Registration <Icon name="external" size={16}/></a>}</aside></div></div></section>
</BaseLayout>
