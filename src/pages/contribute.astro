---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig } from '../data/site';
import { withBase } from '../lib/urls';
---

<BaseLayout title="Contribute" description="Ways to contribute resources, opportunities, stories, events, or project ideas to the SPARK Community Hub.">
  <PageHero eyebrow="Community contribution" title="Help make the hub useful to others." description="SPARK grows through reviewed contributions from Fellows, alumni, collaborators, and the wider AI in Science community." compact><div slot="actions" class="page-actions"><a class="button button-gold" href={`mailto:${siteConfig.contactEmail}?subject=SPARK%20Community%20Hub%20contribution`}>Start a conversation <Icon name="mail" size={18}/></a></div></PageHero>
  <section class="section section-white"><div class="container"><SectionHeading eyebrow="Contribution paths" title="Share knowledge, not sensitive information." description="Structured forms and an editorial workflow will be added later. The current email route is appropriate only for public links and non-sensitive ideas."/><div class="contribute-grid"><a href={withBase('resources/submit/')}><Icon name="document" size={23}/><h2>Suggest a resource</h2><p>Tutorials, documentation, tools, open code, datasets, recordings, or research translation guides.</p><span>Review the criteria <Icon name="arrow-right" size={17}/></span></a><a href={withBase('opportunities/submit/')}><Icon name="globe" size={23}/><h2>Share an opportunity</h2><p>Fellowships, grants, jobs, workshops, challenges, or specific calls for collaboration.</p><span>Review the criteria <Icon name="arrow-right" size={17}/></span></a><a href={`mailto:${siteConfig.contactEmail}?subject=SPARK%20story%20idea`}><Icon name="spark" size={23}/><h2>Propose a story</h2><p>A research-translation lesson, community perspective, project highlight, alumni path, or public-facing synthesis.</p><span>Email an idea <Icon name="arrow-right" size={17}/></span></a><a href={`mailto:${siteConfig.contactEmail}?subject=SPARK%20event%20or%20project%20idea`}><Icon name="calendar" size={23}/><h2>Propose an activity</h2><p>A skills session, alumni talk, office hour, project challenge, showcase, or partner conversation.</p><span>Email an idea <Icon name="arrow-right" size={17}/></span></a></div><div class="notice mt-3"><Icon name="check" size={21}/><p><strong>Editorial review applies to every contribution.</strong> The team may verify sources, edit summaries, request permissions, improve accessibility, decline a submission, archive expired material, or remove content that no longer meets the hub's standards.</p></div></div></section>
</BaseLayout>

<style>.contribute-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.contribute-grid>a{min-height:260px;padding:1.5rem;color:var(--ink);text-decoration:none}.contribute-grid>a:nth-child(even){border-left:1px solid var(--line)}.contribute-grid>a:nth-child(n+3){border-top:1px solid var(--line)}.contribute-grid>a>.icon{color:var(--gold-700);margin-bottom:2.8rem}.contribute-grid h2{font-size:1.25rem}.contribute-grid p{margin-top:.55rem;color:var(--slate);font-size:.86rem}.contribute-grid span{display:flex;align-items:center;gap:.4rem;margin-top:1rem;color:var(--navy-700);font-size:.78rem;font-weight:800}.contribute-grid>a:hover{background:var(--gold-100)}@media(max-width:760px){.contribute-grid{grid-template-columns:1fr}.contribute-grid>a:nth-child(even){border-left:0}.contribute-grid>a+a{border-top:1px solid var(--line)}}</style>
