---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../data/site';
import { withBase } from '../lib/urls';
---

<BaseLayout title="Contact" description="Contact the SPARK Community Hub organizing team.">
  <PageHero eyebrow="Contact" title="Start with the right channel." description="For public program, collaboration, content, and website questions, contact the SPARK organizing team." compact />
  <section class="section section-white"><div class="container contact-grid"><article><span><Icon name="mail" size={23}/></span><h2>General questions</h2><p>Forum planning, public updates, partnership conversations, or website feedback.</p><a class="button button-primary" href={`mailto:${siteConfig.contactEmail}?subject=SPARK%20inquiry`}>Email {siteConfig.contactEmail}</a></article><article><span><Icon name="document" size={23}/></span><h2>Content contributions</h2><p>Suggest a public resource, opportunity, story, activity, or collaboration idea.</p><a class="button button-outline" href={withBase('contribute/')}>Choose a contribution path</a></article></div><div class="narrow notice mt-3"><Icon name="spark" size={21}/><p><strong>Do not email sensitive personal information.</strong> Applications, mentorship preferences, travel details, dietary needs, disability or health information, and other private data will use approved secure forms when those workflows open.</p></div></section>
</BaseLayout>

<style>.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.contact-grid article{border:1px solid var(--line);border-radius:var(--radius);padding:clamp(1.5rem,4vw,2.5rem)}.contact-grid article>span{display:grid;width:3.2rem;height:3.2rem;place-items:center;border-radius:.8rem;background:var(--navy-900);color:var(--gold-400)}.contact-grid h2{margin-top:2.5rem;font-size:1.5rem}.contact-grid p{min-height:3.3rem;margin-top:.7rem;color:var(--slate)}.contact-grid .button{margin-top:1.5rem}@media(max-width:760px){.contact-grid{grid-template-columns:1fr}.contact-grid p{min-height:0}}</style>
