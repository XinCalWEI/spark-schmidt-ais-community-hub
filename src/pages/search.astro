---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Search" description="Search the SPARK Community Hub." noindex>
  <div data-pagefind-ignore>
    <PageHero eyebrow="Site search" title="Find a page, resource, event, or story." description="Search the published content of the SPARK Community Hub. The search index is generated with each production build." compact />
    <section class="section section-white"><div class="narrow"><form class="search-page-form" data-search-form role="search"><label class="sr-only" for="site-search">Search this site</label><div class="input-shell"><Icon name="search" size={18}/><input id="site-search" name="q" type="search" placeholder="Try “responsible AI” or “Docker”" autocomplete="off" data-search-input /></div><button class="button button-primary" type="submit">Search</button></form><p class="search-status" aria-live="polite" data-search-status>Enter a term to search the published site.</p><div class="search-results mt-2" data-search-results></div><noscript><p class="notice mt-2">Site search requires JavaScript. You can still browse content through the main navigation.</p></noscript></div></section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-search-form]');
    const input = document.querySelector('[data-search-input]');
    const status = document.querySelector('[data-search-status]');
    const results = document.querySelector('[data-search-results]');
    const base = document.documentElement.dataset.base || '/';

    const resultUrl = (url) => {
      if (/^https?:\/\//.test(url) || url.startsWith(base)) return url;
      return `${base}${url.replace(/^\/+/, '')}`;
    };

    async function runSearch(query) {
      if (!query.trim()) {
        status.textContent = 'Enter a term to search the published site.';
        results.replaceChildren();
        return;
      }
      status.textContent = 'Searching…';
      results.replaceChildren();
      try {
        const pagefind = await import(`${base}pagefind/pagefind.js`);
        const response = await pagefind.search(query);
        const items = await Promise.all(response.results.slice(0, 20).map((item) => item.data()));
        status.textContent = `${response.results.length} ${response.results.length === 1 ? 'result' : 'results'} for “${query}”.`;
        for (const item of items) {
          const article = document.createElement('article');
          article.className = 'search-result';
          const heading = document.createElement('h2');
          const link = document.createElement('a');
          link.href = resultUrl(item.url);
          link.textContent = item.meta?.title || item.url;
          heading.append(link);
          const excerpt = document.createElement('p');
          excerpt.innerHTML = item.excerpt || '';
          article.append(heading, excerpt);
          results.append(article);
        }
      } catch (error) {
        status.textContent = 'Search is available after a production build. Please use the navigation while previewing the development server.';
      }
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      const url = new URL(window.location.href);
      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      history.replaceState({}, '', url);
      runSearch(query);
    });

    const initial = new URLSearchParams(window.location.search).get('q') || '';
    if (initial) { input.value = initial; runSearch(initial); }
  })();
</script>
