---
import Icon from './Icon.astro';
interface Props { title: string; description: string; icon?: 'calendar' | 'document' | 'people' | 'search' | 'spark'; }
const { title, description, icon = 'spark' } = Astro.props;
---

<div class="empty-state">
  <span class="empty-icon"><Icon name={icon} size={28}/></span>
  <h2>{title}</h2>
  <p>{description}</p>
  <slot />
</div>
