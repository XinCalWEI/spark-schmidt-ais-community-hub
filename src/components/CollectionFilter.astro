---
interface FilterOption { value: string; label: string; }
interface Filter { key: string; label: string; options: FilterOption[]; }
interface Props {
  searchLabel?: string;
  searchPlaceholder?: string;
  filters?: Filter[];
  count: number;
}
const {
  searchLabel = 'Search',
  searchPlaceholder = 'Search this collection',
  filters = [],
  count,
} = Astro.props;
---

<div class="collection-controls" data-filter-controls>
  <div class="filter-search">
    <label for="collection-search">{searchLabel}</label>
    <div class="input-shell">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      <input id="collection-search" type="search" placeholder={searchPlaceholder} data-filter-search autocomplete="off" />
    </div>
  </div>
  {filters.map((filter) => (
    <div class="filter-select">
      <label for={`filter-${filter.key}`}>{filter.label}</label>
      <select id={`filter-${filter.key}`} data-filter-select data-filter-key={filter.key}>
        <option value="">All {filter.label.toLowerCase()}</option>
        {filter.options.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </div>
  ))}
  <button class="filter-clear" type="button" data-filter-clear>Clear filters</button>
  <p class="result-count" aria-live="polite"><strong data-result-count>{count}</strong> <span data-result-label>{count === 1 ? 'result' : 'results'}</span></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-collection-browser]').forEach((browser) => {
    const controls = browser.querySelector<HTMLElement>('[data-filter-controls]');
    if (!controls || controls.dataset.ready === 'true') return;
    controls.dataset.ready = 'true';
    const search = controls.querySelector<HTMLInputElement>('[data-filter-search]');
    const selects = Array.from(controls.querySelectorAll<HTMLSelectElement>('[data-filter-select]'));
    const clear = controls.querySelector<HTMLButtonElement>('[data-filter-clear]');
    const cards = Array.from(browser.querySelectorAll<HTMLElement>('[data-filter-card]'));
    const empty = browser.querySelector<HTMLElement>('[data-filter-empty]');
    const count = controls.querySelector<HTMLElement>('[data-result-count]');
    const label = controls.querySelector<HTMLElement>('[data-result-label]');

    const applyFilters = () => {
      const query = search?.value.trim().toLocaleLowerCase() ?? '';
      let visible = 0;
      cards.forEach((card) => {
        const textMatches = !query || (card.textContent ?? '').toLocaleLowerCase().includes(query);
        const filtersMatch = selects.every((select) => {
          if (!select.value) return true;
          const key = select.dataset.filterKey ?? '';
          const values = (card.getAttribute(`data-${key}`) ?? '').split('|');
          return values.includes(select.value);
        });
        const matches = textMatches && filtersMatch;
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (label) label.textContent = visible === 1 ? 'result' : 'results';
      if (empty) empty.hidden = visible !== 0;
    };

    search?.addEventListener('input', applyFilters);
    selects.forEach((select) => select.addEventListener('change', applyFilters));
    clear?.addEventListener('click', () => {
      if (search) search.value = '';
      selects.forEach((select) => { select.value = ''; });
      applyFilters();
      search?.focus();
    });
  });
</script>
