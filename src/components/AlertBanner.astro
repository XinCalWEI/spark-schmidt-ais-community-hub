---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
import { withBase } from '../lib/urls';
---

{siteConfig.status === 'preview' && (
  <aside class="site-alert" aria-label="Website status">
    <div class="container site-alert-inner">
      <p><strong>Site preview</strong><span aria-hidden="true">—</span> Program, venue, application, and speaker details will be announced as they are confirmed.</p>
      <a href={withBase('forum/faq/')}>What is confirmed? <Icon name="arrow-right" size={16}/></a>
    </div>
  </aside>
)}
